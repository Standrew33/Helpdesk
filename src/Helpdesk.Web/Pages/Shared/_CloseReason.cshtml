@* Asked of a customer who closes a ticket (js/close-reason.js): the reason is sent with the new status. *@
<div class="modal fade" id="close-reason" tabindex="-1" aria-labelledby="close-reason-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form method="post" class="modal-content">
            <input type="hidden" name="rowVersion" value="" />
            <input type="hidden" name="status" value="@TicketStatus.Closed" />
            <div class="modal-header">
                <h2 id="close-reason-title" class="modal-title fs-5">Close the ticket</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cancel"></button>
            </div>
            <div class="modal-body">
                <label for="close-reason-text" class="form-label">Why is the ticket no longer needed?</label>
                <textarea id="close-reason-text" name="reason" class="form-control description-input" rows="3"
                          maxlength="@Ticket.MaxCommentLength" required></textarea>
                <p class="form-text mb-0">The reason is added to the comments, so the support team sees it too.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-link" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary">Close ticket</button>
            </div>
        </form>
    </div>
</div>
