@model Helpdesk.Web.Features.Users.DeleteAccountDialog
@* One dialog for every delete button of the page; js/delete-account.js puts in whom the button is for. *@
<div class="modal fade" id="delete-account" tabindex="-1" aria-labelledby="delete-account-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form method="post" asp-page-handler="Delete" asp-all-route-data="@Model.RouteValues.Where(r => r.Value is not null).ToDictionary(r => r.Key, r => r.Value!)"
              class="modal-content">
            <input type="hidden" name="@Model.IdField" value="" data-delete-id />
            <div class="modal-header">
                <h2 id="delete-account-title" class="modal-title fs-5">Delete the account</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cancel"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">Delete <strong data-delete-name></strong> for good?</p>
                <p class="text-secondary small mb-0">Their tickets and comments stay, signed "Deleted user". This cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-link" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-danger">Delete for good</button>
            </div>
        </form>
    </div>
</div>
