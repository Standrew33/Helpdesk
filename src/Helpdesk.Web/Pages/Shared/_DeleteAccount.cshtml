@model Helpdesk.Web.Features.Users.DeleteAccountButton
@* Deleting cannot be undone, so the button only opens the confirmation dialog (_DeleteAccountDialog). *@
<button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#delete-account"
        data-delete-id="@Model.UserId" data-delete-name="@Model.Name">
    Delete
</button>
