@{
    var page = ViewContext.RouteData.Values["page"] as string ?? "";
    var isSignedIn = User.Identity?.IsAuthenticated == true;
    var displayName = User.DisplayName();
    var email = User.Email();
    var role = User.IsInRole(RoleNames.Admin) ? RoleNames.Admin
        : User.IsInRole(RoleNames.Operator) ? RoleNames.Operator
        : User.IsInRole(RoleNames.Customer) ? RoleNames.Customer
        : "";
    var isOwner = User.IsPlatformOwner();
    var inWorkspace = User.WorkspaceId() is not null;
    var home = inWorkspace ? "/Tickets/Index" : "/Platform/Index";
    var onTickets = page is "/Tickets/Index" or "/Tickets/Details";
    var body = RenderBody();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0e1c1b" />
    <partial name="_SiteMeta" />
    <title>@ViewData["Title"] - Helpdesk</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (isSignedIn)
    {
        <div class="shell">
            <aside class="sidebar">
                <a class="brand" asp-page="@home">
                    <svg width="30" height="30" viewBox="0 0 30 30" aria-hidden="true">
                        <rect width="30" height="30" rx="8" fill="#14b8a6" />
                        <path d="M9 11h12M9 15h12M9 19h7" stroke="#06211e" stroke-width="2" stroke-linecap="round" fill="none" />
                    </svg>
                    <span>Helpdesk</span>
                </a>

                <nav class="side-nav" aria-label="Main">
                    @if (inWorkspace)
                    {
                        <a asp-page="/Tickets/Index" class="side-link @(onTickets ? "active" : "")">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" /></svg>
                            Tickets
                        </a>
                    }
                    @if (role == RoleNames.Customer)
                    {
                        <a asp-page="/Tickets/Create" class="side-link @(page == "/Tickets/Create" ? "active" : "")">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                            New ticket
                        </a>
                    }

                    @if (role is RoleNames.Operator or RoleNames.Admin)
                    {
                        <a asp-page="/Invitations" class="side-link @(page == "/Invitations" ? "active" : "")">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zM22 6l-10 7L2 6" /></svg>
                            Invitations
                        </a>
                    }

                    @if (role == RoleNames.Admin)
                    {
                        <div class="side-section">Administration</div>
                        <a asp-page="/Admin/Users" class="side-link @(page == "/Admin/Users" ? "active" : "")">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" /></svg>
                            Users
                        </a>
                    }

                    @if (isOwner)
                    {
                        <div class="side-section">Platform</div>
                        <a asp-page="/Platform/Index" class="side-link @(page.StartsWith("/Platform/", StringComparison.Ordinal) ? "active" : "")">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6" /></svg>
                            Help desks
                        </a>
                    }
                </nav>

                <div class="side-user">
                    <a asp-page="/Account/Settings" class="user-chip @(page == "/Account/Settings" ? "active" : "")" title="Account settings">
                        <span class="avatar" aria-hidden="true">@(displayName.Length > 0 ? displayName[..1].ToUpperInvariant() : "?")</span>
                        <span class="user-meta">
                            <span class="user-name">@displayName</span>
                            <span class="user-email">@email</span>
                        </span>
                    </a>
                    <form method="post" asp-page="/Account/Logout">
                        <button type="submit" class="btn btn-signout btn-sm">Sign out</button>
                    </form>
                </div>
            </aside>

            <div class="content">
                <main class="page @ViewData["PageClass"]" role="main">
                    @body
                </main>
            </div>
        </div>
    }
    else
    {
        <header class="plain-top">
            <div class="container py-3">
                <a class="brand" asp-page="/Index">
                    <svg width="30" height="30" viewBox="0 0 30 30" aria-hidden="true">
                        <rect width="30" height="30" rx="8" fill="#0f8f7e" />
                        <path d="M9 11h12M9 15h12M9 19h7" stroke="#fff" stroke-width="2" stroke-linecap="round" fill="none" />
                    </svg>
                    <span>Helpdesk</span>
                </a>
            </div>
        </header>
        <main class="container" role="main">
            @body
        </main>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/password-toggle.js" asp-append-version="true"></script>
    <script src="~/js/choice.js" asp-append-version="true"></script>
    <script src="~/js/local-time.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
