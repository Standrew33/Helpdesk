@{
    var page = ViewContext.RouteData.Values["page"] as string ?? "";
    var isSignedIn = User.Identity?.IsAuthenticated == true;
    var displayName = User.Identity?.Name ?? "";
    var role = User.IsInRole(RoleNames.Admin) ? RoleNames.Admin
        : User.IsInRole(RoleNames.Operator) ? RoleNames.Operator
        : User.IsInRole(RoleNames.Customer) ? RoleNames.Customer
        : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#4f46e5" />
    <title>@ViewData["Title"] - Helpdesk</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <div class="container topbar-inner">
            <a class="brand" asp-page="/Index">
                <svg width="30" height="30" viewBox="0 0 30 30" aria-hidden="true">
                    <rect width="30" height="30" rx="8" fill="#4f46e5" />
                    <path d="M9 11h12M9 15h12M9 19h7" stroke="#fff" stroke-width="2" stroke-linecap="round" fill="none" />
                </svg>
                <span>Helpdesk</span>
            </a>

            <nav class="topnav" aria-label="Main">
                @if (isSignedIn)
                {
                    <a asp-page="/Tickets/Index" class="@(page.StartsWith("/Tickets") ? "active" : "")">Tickets</a>
                }
            </nav>

            <div class="topbar-user">
                @if (isSignedIn)
                {
                    <div class="user-chip">
                        <span class="avatar" aria-hidden="true">@(displayName.Length > 0 ? displayName[..1] : "?")</span>
                        <span class="user-meta">
                            <span class="user-name">@displayName</span>
                            <span class="user-role">@role</span>
                        </span>
                    </div>
                    <form method="post" asp-page="/Account/Logout">
                        <button type="submit" class="btn btn-outline-secondary btn-sm">Sign out</button>
                    </form>
                }
                else
                {
                    <a class="btn btn-primary btn-sm" asp-page="/Account/Login">Sign in</a>
                }
            </div>
        </div>
    </header>

    <main class="container page" role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">&copy; 2026 Helpdesk</div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
