@inject Microsoft.Extensions.Options.IOptions<SiteOptions> Site
<link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="~/favicon.ico" sizes="16x16 32x32 48x48" />
<link rel="apple-touch-icon" href="~/apple-touch-icon.png" />
@if (!string.IsNullOrWhiteSpace(Site.Value.GoogleSiteVerification))
{
    <meta name="google-site-verification" content="@Site.Value.GoogleSiteVerification" />
}
