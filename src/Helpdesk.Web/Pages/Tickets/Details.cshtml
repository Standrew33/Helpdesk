@page "{number:int}"
@model Helpdesk.Web.Pages.Tickets.DetailsModel
@{
    var ticket = Model.Details.Ticket;
    ViewData["Title"] = $"Ticket #{ticket.Number}";
    ViewData["PageClass"] = "page-ticket";
    var pencil = new Microsoft.AspNetCore.Html.HtmlString("<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 20h9\" /><path d=\"M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z\" /></svg>");
}

<a class="back-link" asp-page="Index" asp-route-workspaceId="@User.VisitedWorkspaceId()">&larr; All tickets</a>

<div id="ticket-header" class="ticket-header" data-live>
    <div class="ticket-header-top">
        <p class="page-subtitle m-0">Ticket #@ticket.Number</p>
        <div class="d-flex flex-wrap align-items-center gap-2">
            @if (Model.StatusOptions.Count > 1)
            {
                <form method="post" asp-page-handler="Status" data-instant data-close-reason="@(Model.IsStaff ? "" : "required")">
                    <input type="hidden" name="rowVersion" value="@Model.Details.RowVersion" />
                    <span id="StatusLabel" class="visually-hidden">Status</span>
                    <div class="dropdown choice choice-inline" data-choice>
                        <button type="button" id="Status" class="choice-toggle" data-bs-toggle="dropdown" aria-expanded="false" aria-labelledby="StatusLabel Status">
                            <span data-choice-label><span class="@TicketDisplay.StatusClass(ticket.Status)">@TicketDisplay.StatusText(ticket.Status)</span></span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end choice-menu">
                            @foreach (var status in Model.StatusOptions)
                            {
                                <label class="choice-option">
                                    <input type="radio" name="status" value="@status" checked="@(status == ticket.Status)" class="form-check-input" />
                                    <span data-choice-view><span class="@TicketDisplay.StatusClass(status)">@TicketDisplay.StatusText(status)</span></span>
                                </label>
                            }
                        </div>
                    </div>
                </form>
            }
            else
            {
                <span class="@TicketDisplay.StatusClass(ticket.Status)">@TicketDisplay.StatusText(ticket.Status)</span>
            }

            @if (Model.IsOpen)
            {
                <form method="post" asp-page-handler="Priority" class="choice-inline" data-instant>
                    <input type="hidden" name="rowVersion" value="@Model.Details.RowVersion" />
                    <span id="PriorityLabel" class="visually-hidden">Priority</span>
                    <partial name="_PriorityChoice" model="Model.PriorityChoice" />
                </form>
            }
            else
            {
                <partial name="_Priority" model="ticket.Priority" />
            }
        </div>
    </div>

    @* The pencil turns the text into a field; leaving the field saves it. Without scripts the pencil stays hidden. *@
    @if (Model.IsOpen)
    {
        <form method="post" asp-page-handler="Subject" class="inline-edit" data-inline-edit>
            <input type="hidden" name="rowVersion" value="@Model.Details.RowVersion" />
            <h1 class="page-title" data-inline-view>@ticket.Subject</h1>
            <input id="Subject" type="text" name="subject" value="@ticket.Subject" maxlength="@Ticket.MaxSubjectLength" required
                   class="form-control inline-field inline-field-title" aria-label="Subject" hidden data-inline-field />
            <button type="button" id="SubjectEdit" class="icon-btn" title="Edit subject" aria-label="Edit subject" hidden data-inline-start>@pencil</button>
        </form>
    }
    else
    {
        <h1 class="page-title">@ticket.Subject</h1>
    }
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div id="ticket-description" class="card mb-4" data-live>
            <div class="card-body p-4">
                @if (Model.IsOpen)
                {
                    <form method="post" asp-page-handler="Description" data-inline-edit>
                        <input type="hidden" name="rowVersion" value="@Model.Details.RowVersion" />
                        <div class="inline-edit-head">
                            <partial name="_OpenedBy" />
                            <button type="button" id="DescriptionEdit" class="icon-btn" title="Edit description" aria-label="Edit description" hidden data-inline-start>@pencil</button>
                        </div>
                        <p class="description" data-inline-view>@ticket.Description</p>
                        <textarea id="Description" name="description" rows="4" maxlength="@Ticket.MaxDescriptionLength"
                                  class="form-control inline-field inline-field-text" aria-label="Description" hidden data-inline-field data-inline-optional>@ticket.Description</textarea>
                    </form>
                }
                else
                {
                    <div class="inline-edit-head">
                        <partial name="_OpenedBy" />
                    </div>
                    <p class="description">@ticket.Description</p>
                }
            </div>
        </div>

        <div id="ticket-attachments" class="card mb-4" data-live>
            <div class="card-body">
                <h2 class="card-title-sm">Attachments</h2>
                @if (ticket.Attachments.Count == 0)
                {
                    <p class="text-secondary mb-0">No files attached.</p>
                }
                else
                {
                    <ul class="file-list">
                        @foreach (var file in ticket.Attachments.OrderBy(a => a.UploadedAt))
                        {
                            <li>
                                <a asp-page-handler="Download" asp-route-number="@ticket.Number" asp-route-attachmentId="@file.Id">@file.FileName</a>
                                <span class="text-secondary small">
                                    @TicketDisplay.FileSize(file.Size) &middot; @Model.Details.NameOf(file.UploadedById) &middot; @TicketDisplay.Date(file.UploadedAt)
                                </span>
                            </li>
                        }
                    </ul>
                }

                @if (ticket.Status != TicketStatus.Closed && ticket.Attachments.Count < AttachmentPolicy.MaxFilesPerTicket)
                {
                    <form method="post" asp-page-handler="Attachment" enctype="multipart/form-data" class="file-form">
                        <input type="hidden" name="rowVersion" value="@Model.Details.RowVersion" />
                        <input type="file" id="file" name="file" class="visually-hidden" required data-file-input
                               accept="@string.Join(',', AttachmentPolicy.AllowedExtensions.Order())" />
                        <label for="file" class="icon-btn icon-btn-outline" title="Choose a file">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48" /></svg>
                            <span class="visually-hidden">Choose a file</span>
                        </label>
                        <span class="file-name" data-file-name>No file chosen</span>
                        <button type="submit" class="btn btn-outline-primary btn-sm">Attach</button>
                    </form>
                    <p class="text-secondary small mb-0 mt-2">
                        Up to @AttachmentPolicy.MaxFilesPerTicket files, @(AttachmentPolicy.MaxFileBytes / (1024 * 1024)) MB each.
                    </p>
                }
            </div>
        </div>

        @* History and comments show their last five entries; older ones come in fives on request. *@
        @if (Model.IsStaff)
        {
            <details id="ticket-history" class="activity" open data-live>
                <summary>
                    <h2 class="section-title">History</h2>
                    <span class="activity-count">@ticket.History.Count</span>
                </summary>
                <div class="card">
                    <div class="card-body">
                        <ul class="timeline" data-show-last="5">
                            @foreach (var entry in ticket.History.OrderBy(h => h.ChangedAt).ThenBy(h => h.Id))
                            {
                                <li>
                                    @if (entry.Field == "Created")
                                    {
                                        <text>Ticket created</text>
                                    }
                                    else if (entry.Field == "Attachment")
                                    {
                                        <text>Attached @entry.NewValue</text>
                                    }
                                    else if (entry.Field == "Description")
                                    {
                                        <text>Description edited</text>
                                    }
                                    else if (entry.Field == "Assignee")
                                    {
                                        <text>Assignee: @Model.Details.NameOf(entry.OldValue) &rarr; @Model.Details.NameOf(entry.NewValue)</text>
                                    }
                                    else if (entry.Field == "Due date")
                                    {
                                        <text>Due date: @TicketDisplay.DayInHistory(entry.OldValue) &rarr; @TicketDisplay.DayInHistory(entry.NewValue)</text>
                                    }
                                    else
                                    {
                                        <text>@entry.Field: @entry.OldValue &rarr; @entry.NewValue</text>
                                    }
                                    <small>@Model.Details.NameOf(entry.ActorId) &middot; @TicketDisplay.Date(entry.ChangedAt)</small>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </details>
        }

        <details id="ticket-comments" class="activity" open data-live>
            <summary>
                <h2 class="section-title">Comments</h2>
                <span class="activity-count">@Model.Details.Comments.Count</span>
            </summary>
            @if (Model.Details.Comments.Count == 0)
            {
                <p class="text-secondary">No comments yet.</p>
            }
            <div class="comment-list" data-show-last="5">
                @foreach (var comment in Model.Details.Comments)
                {
                    var author = Model.Details.NameOf(comment.AuthorId);
                    <div class="comment @(comment.IsInternal ? "comment-internal" : "")">
                        <span class="avatar" aria-hidden="true">@(author.Length > 0 ? author[..1] : "?")</span>
                        <div class="comment-body">
                            <div class="comment-head">
                                <strong>@author</strong>
                                <span>@TicketDisplay.Date(comment.CreatedAt)</span>
                                @if (comment.IsInternal)
                                {
                                    <span class="tag tag-internal">Internal note</span>
                                }
                                @if (comment.IsClosingReason)
                                {
                                    <span class="tag tag-closing">Reason for closing</span>
                                }
                            </div>
                            <div class="comment-text">@comment.Body</div>
                        </div>
                    </div>
                }
            </div>
        </details>

        <div id="ticket-reply" data-live>
            @if (ticket.Status != TicketStatus.Closed)
            {
                <div class="card mt-3">
                    <div class="card-body">
                        <form method="post" asp-page-handler="Comment">
                            <input type="hidden" name="rowVersion" value="@Model.Details.RowVersion" />
                            <label for="body" class="form-label">Add a comment</label>
                            <textarea id="body" name="body" class="form-control comment-input mb-3" rows="3" maxlength="@Ticket.MaxCommentLength" required></textarea>
                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                                @if (Model.IsStaff)
                                {
                                    <div class="form-check mb-0">
                                        <input id="isInternal" name="isInternal" type="checkbox" value="true" class="form-check-input" />
                                        <label for="isInternal" class="form-check-label">Internal note (hidden from the customer)</label>
                                    </div>
                                }
                                else
                                {
                                    <span></span>
                                }
                                <button type="submit" class="btn btn-primary">Send</button>
                            </div>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>

    <div id="ticket-aside" class="col-lg-4" data-live>
        <div class="card mb-3">
            <div class="card-body">
                <h2 class="card-title-sm">Details</h2>
                <dl class="meta-list">
                    <div>
                        <dt><label for="assigneeId" class="m-0">Assignee</label></dt>
                        <dd>
                            @if (Model.IsStaff && Model.IsOpen)
                            {
                                <form method="post" asp-page-handler="Assign" data-instant>
                                    <input type="hidden" name="rowVersion" value="@Model.Details.RowVersion" />
                                    <select id="assigneeId" name="assigneeId" class="form-select form-select-sm meta-select">
                                        <option value="">Unassigned</option>
                                        @foreach (var option in Model.Assignees)
                                        {
                                            <option value="@option.Id" selected="@(option.Id == ticket.AssigneeId)">@option.Name</option>
                                        }
                                    </select>
                                    <noscript><button type="submit" class="btn btn-outline-primary btn-sm mt-2">Assign</button></noscript>
                                </form>
                            }
                            else
                            {
                                @Model.Details.NameOf(ticket.AssigneeId)
                            }
                        </dd>
                    </div>
                    <div>
                        <dt><label for="dueDate" class="m-0">Due</label></dt>
                        <dd class="@(ticket.IsOverdue(DateTimeOffset.UtcNow) ? "overdue" : "")">
                            @if (Model.IsOpen)
                            {
                                @* A calendar (js/date-picker.js); no day chosen means no due date. *@
                                <form method="post" asp-page-handler="DueDate" data-instant>
                                    <input type="hidden" name="rowVersion" value="@Model.Details.RowVersion" />
                                    <input id="dueDate" type="date" name="dueDate" value="@TicketDisplay.DayValue(ticket.DueDate)"
                                           min="@TicketDisplay.DayValue(Model.EarliestDueDate)" class="form-control form-control-sm"
                                           data-date-picker data-placeholder="No due date" />
                                    <noscript><button type="submit" class="btn btn-outline-primary btn-sm mt-2">Save</button></noscript>
                                </form>
                            }
                            else
                            {
                                @TicketDisplay.Day(ticket.DueDate, Model.Today)
                            }
                        </dd>
                    </div>
                    <div><dt>Last update</dt><dd>@TicketDisplay.Date(ticket.UpdatedAt)</dd></div>
                </dl>
            </div>
        </div>
    </div>
</div>

@if (!Model.IsStaff && Model.IsOpen)
{
    <partial name="_CloseReason" />
}

@section Scripts {
    <script src="~/js/date-picker.js" asp-append-version="true"></script>
    <script src="~/js/ticket-page.js" asp-append-version="true"></script>
    <script src="~/js/close-reason.js" asp-append-version="true"></script>
}
