@page "{id:int}"
@model Helpdesk.Web.Pages.Tickets.DetailsModel
@{
    var ticket = Model.Details.Ticket;
    ViewData["Title"] = $"Ticket #{ticket.Id}";
}

<a class="back-link" asp-page="Index">&larr; All tickets</a>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger" role="alert">@Model.Error</div>
}

<div class="page-header">
    <div>
        <p class="page-subtitle mt-0 mb-1">Ticket #@ticket.Id</p>
        <h1 class="page-title">@ticket.Subject</h1>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <span class="@TicketDisplay.StatusClass(ticket.Status)">@TicketDisplay.StatusText(ticket.Status)</span>
        <span class="@TicketDisplay.PriorityClass(ticket.Priority)">@ticket.Priority</span>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-body p-4">
                <p class="text-secondary small mb-3">
                    Opened by <strong class="text-body">@Model.Details.NameOf(ticket.CustomerId)</strong>
                    on @TicketDisplay.Date(ticket.CreatedAt)
                </p>
                <p class="description">@ticket.Description</p>
            </div>
        </div>

        <h2 class="section-title">Comments</h2>
        @if (Model.Details.Comments.Count == 0)
        {
            <p class="text-secondary">No comments yet.</p>
        }
        @foreach (var comment in Model.Details.Comments)
        {
            var author = Model.Details.NameOf(comment.AuthorId);
            <div class="comment @(comment.IsInternal ? "comment-internal" : "")">
                <span class="avatar" aria-hidden="true">@(author.Length > 0 ? author[..1] : "?")</span>
                <div class="comment-body">
                    <div class="comment-head">
                        <strong>@author</strong>
                        <span>@TicketDisplay.Date(comment.CreatedAt)</span>
                        @if (comment.IsInternal)
                        {
                            <span class="tag tag-high">Internal note</span>
                        }
                    </div>
                    <div class="comment-text">@comment.Body</div>
                </div>
            </div>
        }

        @if (ticket.Status != TicketStatus.Closed)
        {
            <div class="card mt-3">
                <div class="card-body">
                    <form method="post" asp-page-handler="Comment">
                        <input type="hidden" name="rowVersion" value="@Model.Details.RowVersion" />
                        <label for="body" class="form-label">Add a comment</label>
                        <textarea id="body" name="body" class="form-control mb-3" rows="3" maxlength="@Ticket.MaxCommentLength" required></textarea>
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                            @if (Model.IsStaff)
                            {
                                <div class="form-check mb-0">
                                    <input id="isInternal" name="isInternal" type="checkbox" value="true" class="form-check-input" />
                                    <label for="isInternal" class="form-check-label">Internal note (hidden from the customer)</label>
                                </div>
                            }
                            else
                            {
                                <span></span>
                            }
                            <button type="submit" class="btn btn-primary">Send</button>
                        </div>
                    </form>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-body">
                <h2 class="card-title-sm">Details</h2>
                <dl class="meta-list">
                    <div><dt>Assignee</dt><dd>@Model.Details.NameOf(ticket.AssigneeId)</dd></div>
                    <div><dt>Due</dt><dd class="@(ticket.IsSlaBreached(DateTimeOffset.UtcNow) ? "overdue" : "")">@TicketDisplay.Date(ticket.DueAt)</dd></div>
                    <div><dt>Last update</dt><dd>@TicketDisplay.Date(ticket.UpdatedAt)</dd></div>
                </dl>
            </div>
        </div>

        @if (Model.AllowedStatuses.Count > 0)
        {
            <form method="post" asp-page-handler="Status" class="card card-body mb-3">
                <input type="hidden" name="rowVersion" value="@Model.Details.RowVersion" />
                <label for="status" class="form-label">Change status</label>
                <select id="status" name="status" class="form-select mb-2">
                    @foreach (var status in Model.AllowedStatuses)
                    {
                        <option value="@status">@TicketDisplay.StatusText(status)</option>
                    }
                </select>
                <button type="submit" class="btn btn-outline-primary">Apply</button>
            </form>
        }

        @if (Model.IsStaff && ticket.Status != TicketStatus.Closed)
        {
            <form method="post" asp-page-handler="Assign" class="card card-body mb-3">
                <input type="hidden" name="rowVersion" value="@Model.Details.RowVersion" />
                <label for="assigneeId" class="form-label">Assign to</label>
                <select id="assigneeId" name="assigneeId" class="form-select mb-2">
                    <option value="">Unassigned</option>
                    @foreach (var option in Model.Assignees)
                    {
                        <option value="@option.Id" selected="@(option.Id == ticket.AssigneeId)">@option.Name</option>
                    }
                </select>
                <button type="submit" class="btn btn-outline-primary">Apply</button>
            </form>

            <form method="post" asp-page-handler="Priority" class="card card-body mb-3">
                <input type="hidden" name="rowVersion" value="@Model.Details.RowVersion" />
                <label for="priority" class="form-label">Priority</label>
                <select id="priority" name="priority" class="form-select mb-2">
                    @foreach (var priority in Enum.GetValues<TicketPriority>())
                    {
                        <option value="@priority" selected="@(priority == ticket.Priority)">@priority</option>
                    }
                </select>
                <button type="submit" class="btn btn-outline-primary">Apply</button>
            </form>
        }

        @if (Model.IsStaff)
        {
            <div class="card">
                <div class="card-body">
                    <h2 class="card-title-sm">History</h2>
                    <ul class="timeline">
                        @foreach (var entry in ticket.History.OrderBy(h => h.ChangedAt).ThenBy(h => h.Id))
                        {
                            <li>
                                @if (entry.Field == "Created")
                                {
                                    <text>Ticket created</text>
                                }
                                else if (entry.Field == "Assignee")
                                {
                                    <text>Assignee: @Model.Details.NameOf(entry.OldValue) &rarr; @Model.Details.NameOf(entry.NewValue)</text>
                                }
                                else
                                {
                                    <text>@entry.Field: @entry.OldValue &rarr; @entry.NewValue</text>
                                }
                                <small>@Model.Details.NameOf(entry.ActorId) &middot; @TicketDisplay.Date(entry.ChangedAt)</small>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }
    </div>
</div>
