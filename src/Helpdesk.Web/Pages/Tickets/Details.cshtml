@page "{id:int}"
@model Helpdesk.Web.Pages.Tickets.DetailsModel
@{
    var ticket = Model.Details.Ticket;
    ViewData["Title"] = $"Ticket #{ticket.Id}";
}

<p><a asp-page="Index">&larr; All tickets</a></p>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger" role="alert">@Model.Error</div>
}

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">#@ticket.Id @ticket.Subject</h1>
    <span class="badge @TicketDisplay.StatusBadge(ticket.Status)">@TicketDisplay.StatusText(ticket.Status)</span>
    <span class="badge @TicketDisplay.PriorityBadge(ticket.Priority)">@ticket.Priority</span>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-body">
                <p class="text-muted small mb-2">
                    Opened by @Model.Details.NameOf(ticket.CustomerId) on @TicketDisplay.Date(ticket.CreatedAt)
                </p>
                <p class="mb-0" style="white-space: pre-wrap;">@ticket.Description</p>
            </div>
        </div>

        <h2 class="h5">Comments</h2>
        @if (Model.Details.Comments.Count == 0)
        {
            <p class="text-muted">No comments yet.</p>
        }
        @foreach (var comment in Model.Details.Comments)
        {
            <div class="card mb-2 @(comment.IsInternal ? "border-warning" : "")">
                <div class="card-body py-2">
                    <div class="small text-muted mb-1">
                        @Model.Details.NameOf(comment.AuthorId) &middot; @TicketDisplay.Date(comment.CreatedAt)
                        @if (comment.IsInternal)
                        {
                            <span class="badge text-bg-warning ms-1">Internal</span>
                        }
                    </div>
                    <div style="white-space: pre-wrap;">@comment.Body</div>
                </div>
            </div>
        }

        @if (ticket.Status != TicketStatus.Closed)
        {
            <form method="post" asp-page-handler="Comment" class="mt-3">
                <input type="hidden" name="rowVersion" value="@Model.Details.RowVersion" />
                <div class="mb-2">
                    <label for="body" class="form-label">Add a comment</label>
                    <textarea id="body" name="body" class="form-control" rows="3" maxlength="@Ticket.MaxCommentLength" required></textarea>
                </div>
                @if (Model.IsStaff)
                {
                    <div class="form-check mb-2">
                        <input id="isInternal" name="isInternal" type="checkbox" value="true" class="form-check-input" />
                        <label for="isInternal" class="form-check-label">Internal note (hidden from the customer)</label>
                    </div>
                }
                <button type="submit" class="btn btn-primary">Send</button>
            </form>
        }
    </div>

    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-body">
                <dl class="mb-0">
                    <dt>Assignee</dt>
                    <dd>@Model.Details.NameOf(ticket.AssigneeId)</dd>
                    <dt>Due</dt>
                    <dd class="@(ticket.IsSlaBreached(DateTimeOffset.UtcNow) ? "text-danger" : "")">@TicketDisplay.Date(ticket.DueAt)</dd>
                    <dt>Last update</dt>
                    <dd class="mb-0">@TicketDisplay.Date(ticket.UpdatedAt)</dd>
                </dl>
            </div>
        </div>

        @if (Model.AllowedStatuses.Count > 0)
        {
            <form method="post" asp-page-handler="Status" class="card card-body mb-3">
                <input type="hidden" name="rowVersion" value="@Model.Details.RowVersion" />
                <label for="status" class="form-label">Change status</label>
                <select id="status" name="status" class="form-select mb-2">
                    @foreach (var status in Model.AllowedStatuses)
                    {
                        <option value="@status">@TicketDisplay.StatusText(status)</option>
                    }
                </select>
                <button type="submit" class="btn btn-outline-primary">Apply</button>
            </form>
        }

        @if (Model.IsStaff && ticket.Status != TicketStatus.Closed)
        {
            <form method="post" asp-page-handler="Assign" class="card card-body mb-3">
                <input type="hidden" name="rowVersion" value="@Model.Details.RowVersion" />
                <label for="assigneeId" class="form-label">Assign to</label>
                <select id="assigneeId" name="assigneeId" class="form-select mb-2">
                    <option value="">Unassigned</option>
                    @foreach (var option in Model.Assignees)
                    {
                        <option value="@option.Id" selected="@(option.Id == ticket.AssigneeId)">@option.Name</option>
                    }
                </select>
                <button type="submit" class="btn btn-outline-primary">Apply</button>
            </form>

            <form method="post" asp-page-handler="Priority" class="card card-body mb-3">
                <input type="hidden" name="rowVersion" value="@Model.Details.RowVersion" />
                <label for="priority" class="form-label">Priority</label>
                <select id="priority" name="priority" class="form-select mb-2">
                    @foreach (var priority in Enum.GetValues<TicketPriority>())
                    {
                        <option value="@priority" selected="@(priority == ticket.Priority)">@priority</option>
                    }
                </select>
                <button type="submit" class="btn btn-outline-primary">Apply</button>
            </form>
        }
    </div>
</div>

@if (Model.IsStaff)
{
    <h2 class="h5 mt-4">History</h2>
    <div class="table-responsive">
        <table class="table table-sm">
            <thead>
                <tr><th>When</th><th>Who</th><th>Change</th></tr>
            </thead>
            <tbody>
                @foreach (var entry in ticket.History.OrderBy(h => h.ChangedAt).ThenBy(h => h.Id))
                {
                    <tr>
                        <td>@TicketDisplay.Date(entry.ChangedAt)</td>
                        <td>@Model.Details.NameOf(entry.ActorId)</td>
                        <td>
                            @if (entry.Field == "Created")
                            {
                                <text>Ticket created</text>
                            }
                            else if (entry.Field == "Assignee")
                            {
                                <text>Assignee: @Model.Details.NameOf(entry.OldValue) &rarr; @Model.Details.NameOf(entry.NewValue)</text>
                            }
                            else
                            {
                                <text>@entry.Field: @entry.OldValue &rarr; @entry.NewValue</text>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
