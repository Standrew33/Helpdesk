@page
@model Helpdesk.Web.Pages.Tickets.CreateModel
@{
    ViewData["Title"] = "New ticket";
}

<a class="back-link" asp-page="Index">&larr; All tickets</a>

<div class="page-header">
    <div>
        <h1 class="page-title">New ticket</h1>
        <p class="page-subtitle">Describe the problem and the support team will pick it up.</p>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body p-4">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-2"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Subject" class="form-label"></label>
                        <input asp-for="Input.Subject" class="form-control" />
                        <span asp-validation-for="Input.Subject" class="field-validation-error"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Description" class="form-label"></label>
                        <textarea asp-for="Input.Description" class="form-control" rows="7"></textarea>
                        <span asp-validation-for="Input.Description" class="field-validation-error"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Input.Priority" class="form-label"></label>
                        <select asp-for="Input.Priority" class="form-select" asp-items="Helpdesk.Web.Pages.Tickets.CreateModel.PriorityOptions"></select>
                    </div>
                    <button type="submit" class="btn btn-primary">Create ticket</button>
                    <a class="btn btn-link" asp-page="Index">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
