@page
@model Helpdesk.Web.Pages.Tickets.IndexModel
@{
    ViewData["Title"] = "Tickets";
    ViewData["PageClass"] = "page-wide";
    var result = Model.Result;
}

<div class="page-header">
    <div>
        <h1 class="page-title">Tickets</h1>
        <p class="page-subtitle">
            @(Model.IsCustomer ? "Your requests" : "All requests")
            <span id="ticket-summary" data-live>&middot; @result.Total @(result.Total == 1 ? "ticket" : "tickets") @(Model.IsFiltered ? "match" : "in total")</span>
        </p>
    </div>
    @if (Model.IsCustomer)
    {
        <a class="btn btn-primary" asp-page="Create">New ticket</a>
    }
</div>

<form method="get" class="toolbar" role="search" data-live-filters>
    <input type="search" name="q" value="@Model.Search" maxlength="100" class="form-control toolbar-search"
           placeholder="Search subject, description or #number" aria-label="Search tickets" autocomplete="off" />
    <partial name="_FilterChoice" model="Model.StatusChoice" />
    <partial name="_FilterChoice" model="Model.PriorityChoice" />
    @if (!Model.IsCustomer)
    {
        <partial name="_FilterChoice" model="Model.ScopeChoice" />
    }
    <span id="ticket-sort" data-live>
        @if (Model.Sort is not null)
        {
            <input type="hidden" name="sort" value="@Model.Sort" />
        }
        @if (Model.Dir is "asc" or "desc")
        {
            <input type="hidden" name="dir" value="@Model.Dir" />
        }
    </span>
    <noscript><button type="submit" class="btn btn-primary">Apply</button></noscript>
    <span id="ticket-reset" data-live>
        @if (Model.IsFiltered)
        {
            <a class="btn btn-link" asp-page="Index">Reset</a>
        }
    </span>
</form>

<div id="ticket-results" data-live>

@if (result.Items.Count == 0)
{
    <div class="card">
        <div class="empty-state">
            <h2>No tickets found</h2>
            @if (Model.IsFiltered)
            {
                <p>Nothing matches these filters.</p>
                <a class="btn btn-outline-secondary" asp-page="Index">Reset filters</a>
            }
            else if (Model.IsCustomer)
            {
                <p>Create a ticket and the support team will pick it up.</p>
                <a class="btn btn-primary" asp-page="Create">New ticket</a>
            }
            else
            {
                <p>The queue is empty.</p>
            }
        </div>
    </div>
}
else
{
    <div class="card overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle ticket-table">
                <thead>
                    <tr>
                        @foreach (var (column, title) in Helpdesk.Web.Pages.Tickets.IndexModel.Columns)
                        {
                            <th aria-sort="@Model.SortStateOf(column)">
                                <a class="sort-link" href="@Model.UrlForSort(column)" data-live-link>@title</a>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in result.Items)
                    {
                        <tr>
                            <td class="ticket-id">@item.Number</td>
                            <td><a class="ticket-subject" asp-page="Details" asp-route-number="@item.Number">@item.Subject</a></td>
                            <td><span class="@TicketDisplay.StatusClass(item.Status)">@TicketDisplay.StatusText(item.Status)</span></td>
                            <td><partial name="_Priority" model="item.Priority" /></td>
                            <td>@item.CustomerName</td>
                            <td>@(item.AssigneeName ?? "–")</td>
                            <td class="text-nowrap @(item.IsOverdue ? "overdue" : "")">@TicketDisplay.Date(item.DueAt)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (result.PageCount > 1)
    {
        <nav class="pager" aria-label="Pages">
            @if (result.HasPrevious)
            {
                <a class="btn btn-outline-secondary btn-sm" href="@Model.UrlForPage(result.Page - 1)" rel="prev" data-live-link>&larr; Previous</a>
            }
            else
            {
                <span class="btn btn-outline-secondary btn-sm disabled" aria-disabled="true">&larr; Previous</span>
            }
            <span class="pager-info">Page @result.Page of @result.PageCount</span>
            @if (result.HasNext)
            {
                <a class="btn btn-outline-secondary btn-sm" href="@Model.UrlForPage(result.Page + 1)" rel="next" data-live-link>Next &rarr;</a>
            }
            else
            {
                <span class="btn btn-outline-secondary btn-sm disabled" aria-disabled="true">Next &rarr;</span>
            }
        </nav>
    }
}
</div>

@section Scripts {
    <script src="~/js/ticket-filters.js" asp-append-version="true"></script>
}
