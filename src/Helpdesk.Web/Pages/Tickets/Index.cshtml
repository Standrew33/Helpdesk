@page
@model Helpdesk.Web.Pages.Tickets.IndexModel
@{
    ViewData["Title"] = "Tickets";
    var result = Model.Result;
}

<div class="page-header">
    <div>
        <h1 class="page-title">Tickets</h1>
        <p class="page-subtitle">
            @(Model.IsCustomer ? "Your requests" : "All requests")
            &middot; @result.Total @(result.Total == 1 ? "ticket" : "tickets") @(Model.IsFiltered ? "match" : "in total")
        </p>
    </div>
    @if (Model.IsCustomer)
    {
        <a class="btn btn-primary" asp-page="Create">New ticket</a>
    }
</div>

<form method="get" class="toolbar" role="search">
    <input type="search" name="q" value="@Model.Search" maxlength="100" class="form-control toolbar-search"
           placeholder="Search subject, description or #number" aria-label="Search tickets" />
    <select name="status" class="form-select toolbar-select" aria-label="Status">
        <option value="">Any status</option>
        @foreach (var status in Enum.GetValues<TicketStatus>())
        {
            <option value="@status" selected="@(Model.Status == status)">@TicketDisplay.StatusText(status)</option>
        }
    </select>
    <select name="priority" class="form-select toolbar-select" aria-label="Priority">
        <option value="">Any priority</option>
        @foreach (var priority in Enum.GetValues<TicketPriority>())
        {
            <option value="@priority" selected="@(Model.Priority == priority)">@priority</option>
        }
    </select>
    @if (!Model.IsCustomer)
    {
        <select name="scope" class="form-select toolbar-select" aria-label="Queue">
            <option value="">Whole queue</option>
            <option value="Mine" selected="@(Model.Scope == TicketScope.Mine)">Assigned to me</option>
            <option value="Unassigned" selected="@(Model.Scope == TicketScope.Unassigned)">Unassigned</option>
            <option value="Overdue" selected="@(Model.Scope == TicketScope.Overdue)">Overdue</option>
        </select>
    }
    <button type="submit" class="btn btn-primary">Apply</button>
    @if (Model.IsFiltered)
    {
        <a class="btn btn-link" asp-page="Index">Reset</a>
    }
</form>

@if (result.Items.Count == 0)
{
    <div class="card">
        <div class="empty-state">
            <h2>No tickets found</h2>
            @if (Model.IsFiltered)
            {
                <p>Nothing matches these filters.</p>
                <a class="btn btn-outline-secondary" asp-page="Index">Reset filters</a>
            }
            else if (Model.IsCustomer)
            {
                <p>Create a ticket and the support team will pick it up.</p>
                <a class="btn btn-primary" asp-page="Create">New ticket</a>
            }
            else
            {
                <p>The queue is empty.</p>
            }
        </div>
    </div>
}
else
{
    <div class="card overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle ticket-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Subject</th>
                        <th>Status</th>
                        <th>Priority</th>
                        <th>Customer</th>
                        <th>Assignee</th>
                        <th>Due</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in result.Items)
                    {
                        <tr>
                            <td class="ticket-id">@item.Id</td>
                            <td><a class="ticket-subject" asp-page="Details" asp-route-id="@item.Id">@item.Subject</a></td>
                            <td><span class="@TicketDisplay.StatusClass(item.Status)">@TicketDisplay.StatusText(item.Status)</span></td>
                            <td><span class="@TicketDisplay.PriorityClass(item.Priority)">@item.Priority</span></td>
                            <td>@item.CustomerName</td>
                            <td>@(item.AssigneeName ?? "–")</td>
                            <td class="text-nowrap @(item.IsOverdue ? "overdue" : "")">@TicketDisplay.Date(item.DueAt)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (result.PageCount > 1)
    {
        <nav class="pager" aria-label="Pages">
            @if (result.HasPrevious)
            {
                <a class="btn btn-outline-secondary btn-sm" asp-page="Index" asp-all-route-data="Model.RouteForPage(result.Page - 1)" rel="prev">&larr; Previous</a>
            }
            else
            {
                <span class="btn btn-outline-secondary btn-sm disabled" aria-disabled="true">&larr; Previous</span>
            }
            <span class="pager-info">Page @result.Page of @result.PageCount</span>
            @if (result.HasNext)
            {
                <a class="btn btn-outline-secondary btn-sm" asp-page="Index" asp-all-route-data="Model.RouteForPage(result.Page + 1)" rel="next">Next &rarr;</a>
            }
            else
            {
                <span class="btn btn-outline-secondary btn-sm disabled" aria-disabled="true">Next &rarr;</span>
            }
        </nav>
    }
}
