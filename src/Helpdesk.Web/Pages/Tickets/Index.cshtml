@page
@model Helpdesk.Web.Pages.Tickets.IndexModel
@{
    ViewData["Title"] = "Tickets";
    ViewData["PageClass"] = "page-wide";
    var result = Model.Result;
}

<div class="page-header">
    <div>
        <h1 class="page-title">Tickets</h1>
        <p class="page-subtitle">
            @(Model.IsCustomer ? "Your requests" : "All requests")
            <span id="ticket-summary" data-live>&middot; @result.Total @(result.Total == 1 ? "ticket" : "tickets") @(Model.IsFiltered ? "match" : "in total")</span>
        </p>
    </div>
    @if (Model.IsCustomer)
    {
        <a class="btn btn-primary btn-square" asp-page="Create" title="New ticket" aria-label="New ticket">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
        </a>
    }
</div>

<form method="get" class="toolbar" role="search" data-live-filters>
    <input type="search" name="q" value="@Model.Search" maxlength="100" class="form-control toolbar-search"
           placeholder="Search subject, description or #number" aria-label="Search tickets" autocomplete="off" />
    <partial name="_FilterChoice" model="Model.StatusChoice" />
    <partial name="_FilterChoice" model="Model.PriorityChoice" />
    @if (!Model.IsCustomer)
    {
        <partial name="_FilterChoice" model="Model.ScopeChoice" />
    }
    <span id="ticket-sort" data-live>
        @if (Model.Sort is not null)
        {
            <input type="hidden" name="sort" value="@Model.Sort" />
        }
        @if (Model.Dir is "asc" or "desc")
        {
            <input type="hidden" name="dir" value="@Model.Dir" />
        }
    </span>
    <noscript><button type="submit" class="btn btn-primary">Apply</button></noscript>
    <span id="ticket-reset" data-live>
        @if (Model.IsFiltered)
        {
            <a class="icon-btn icon-btn-round" asp-page="Index" title="Reset filters" aria-label="Reset filters">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="m15 9-6 6M9 9l6 6" /></svg>
            </a>
        }
    </span>
</form>

<div id="ticket-results" data-live>

@if (result.Items.Count == 0)
{
    <div class="card">
        <div class="empty-state">
            <h2>No tickets found</h2>
            @if (Model.IsFiltered)
            {
                <p>Nothing matches these filters.</p>
                <a class="btn btn-outline-secondary" asp-page="Index">Reset filters</a>
            }
            else if (Model.IsCustomer)
            {
                <p>Create a ticket and the support team will pick it up.</p>
                <a class="btn btn-primary" asp-page="Create">New ticket</a>
            }
            else
            {
                <p>The queue is empty.</p>
            }
        </div>
    </div>
}
else
{
    <div class="card overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle ticket-table">
                <thead>
                    <tr>
                        @foreach (var (column, title) in Helpdesk.Web.Pages.Tickets.IndexModel.Columns)
                        {
                            <th aria-sort="@Model.SortStateOf(column)">
                                <a class="sort-link" href="@Model.UrlForSort(column)" data-live-link>@title</a>
                            </th>
                        }
                        <th class="ticket-open-col"><span class="visually-hidden">Open</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in result.Items)
                    {
                        <tr data-open="@Url.Page("Details", new { number = item.Number })">
                            <td class="ticket-id">@item.Number</td>
                            <td><span class="ticket-subject">@item.Subject</span></td>
                            @* Status and priority change right here, through the handlers of the ticket page. *@
                            <td>
                                @if (Model.StatusOptionsFor(item.Status) is { Count: > 1 } statuses)
                                {
                                    <form method="post" asp-page="Details" asp-page-handler="Status" asp-route-number="@item.Number"
                                          data-row-instant data-close-reason="@(Model.IsCustomer ? "required" : "")">
                                        <input type="hidden" name="rowVersion" value="@item.RowVersion" />
                                        <span id="Status@(item.Number)Label" class="visually-hidden">Status of ticket #@item.Number</span>
                                        <div class="dropdown choice choice-inline" data-choice>
                                            <button type="button" id="Status@(item.Number)" class="choice-toggle" data-bs-toggle="dropdown" aria-expanded="false"
                                                    aria-labelledby="Status@(item.Number)Label Status@(item.Number)" data-bs-popper-config="{&quot;strategy&quot;:&quot;fixed&quot;}">
                                                <span data-choice-label><span class="@TicketDisplay.StatusClass(item.Status)">@TicketDisplay.StatusText(item.Status)</span></span>
                                            </button>
                                            <div class="dropdown-menu choice-menu">
                                                @foreach (var status in statuses)
                                                {
                                                    <label class="choice-option">
                                                        <input type="radio" name="status" value="@status" checked="@(status == item.Status)" class="form-check-input" />
                                                        <span data-choice-view><span class="@TicketDisplay.StatusClass(status)">@TicketDisplay.StatusText(status)</span></span>
                                                    </label>
                                                }
                                            </div>
                                        </div>
                                    </form>
                                }
                                else
                                {
                                    <span class="@TicketDisplay.StatusClass(item.Status)">@TicketDisplay.StatusText(item.Status)</span>
                                }
                            </td>
                            <td>
                                @if (item.Status != TicketStatus.Closed)
                                {
                                    <form method="post" asp-page="Details" asp-page-handler="Priority" asp-route-number="@item.Number"
                                          class="choice-inline" data-row-instant>
                                        <input type="hidden" name="rowVersion" value="@item.RowVersion" />
                                        <span id="Priority@(item.Number)Label" class="visually-hidden">Priority of ticket #@item.Number</span>
                                        <partial name="_PriorityChoice" model="Model.PriorityChoiceFor(item)" />
                                    </form>
                                }
                                else
                                {
                                    <partial name="_Priority" model="item.Priority" />
                                }
                            </td>
                            <td>@item.CustomerName</td>
                            <td>@(item.AssigneeName ?? "–")</td>
                            <td class="text-nowrap @(item.IsOverdue ? "overdue" : "")">@TicketDisplay.Day(item.DueDate, Model.Today)</td>
                            <td class="ticket-open-col">
                                <a class="icon-btn" asp-page="Details" asp-route-number="@item.Number" title="Open ticket #@item.Number" aria-label="Open ticket #@item.Number">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6M10 14 21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" /></svg>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (result.PageCount > 1)
    {
        <nav class="pager" aria-label="Pages">
            @if (result.HasPrevious)
            {
                <a class="btn btn-outline-secondary btn-sm" href="@Model.UrlForPage(result.Page - 1)" rel="prev" data-live-link>&larr; Previous</a>
            }
            else
            {
                <span class="btn btn-outline-secondary btn-sm disabled" aria-disabled="true">&larr; Previous</span>
            }
            <span class="pager-info">Page @result.Page of @result.PageCount</span>
            @if (result.HasNext)
            {
                <a class="btn btn-outline-secondary btn-sm" href="@Model.UrlForPage(result.Page + 1)" rel="next" data-live-link>Next &rarr;</a>
            }
            else
            {
                <span class="btn btn-outline-secondary btn-sm disabled" aria-disabled="true">Next &rarr;</span>
            }
        </nav>
    }
}
</div>

@if (Model.IsCustomer)
{
    <partial name="_CloseReason" />
}

@section Scripts {
    <script src="~/js/ticket-filters.js" asp-append-version="true"></script>
    <script src="~/js/close-reason.js" asp-append-version="true"></script>
}
