@page
@model Helpdesk.Web.Pages.Tickets.IndexModel
@{
    ViewData["Title"] = "Tickets";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Tickets</h1>
        <p class="page-subtitle">
            @(Model.IsCustomer ? "Your requests" : "All requests")
            &middot; @Model.Items.Count shown
        </p>
    </div>
    @if (Model.IsCustomer)
    {
        <a class="btn btn-primary" asp-page="Create">New ticket</a>
    }
</div>

<nav class="filter-chips d-lg-none" aria-label="Filter by status">
    <a asp-page="Index" class="@(Model.Status is null ? "active" : "")">All</a>
    @foreach (var status in Enum.GetValues<TicketStatus>())
    {
        <a asp-page="Index" asp-route-status="@status" class="@(Model.Status == status ? "active" : "")">@TicketDisplay.StatusText(status)</a>
    }
</nav>

@if (Model.Items.Count == 0)
{
    <div class="card">
        <div class="empty-state">
            <h2>No tickets found</h2>
            @if (Model.IsCustomer)
            {
                <p>Create a ticket and the support team will pick it up.</p>
                <a class="btn btn-primary" asp-page="Create">New ticket</a>
            }
            else
            {
                <p>Nothing matches this filter.</p>
            }
        </div>
    </div>
}
else
{
    <div class="card overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle ticket-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Subject</th>
                        <th>Status</th>
                        <th>Priority</th>
                        <th>Customer</th>
                        <th>Assignee</th>
                        <th>Due</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="ticket-id">@item.Id</td>
                            <td><a class="ticket-subject" asp-page="Details" asp-route-id="@item.Id">@item.Subject</a></td>
                            <td><span class="@TicketDisplay.StatusClass(item.Status)">@TicketDisplay.StatusText(item.Status)</span></td>
                            <td><span class="@TicketDisplay.PriorityClass(item.Priority)">@item.Priority</span></td>
                            <td>@item.CustomerName</td>
                            <td>@(item.AssigneeName ?? "–")</td>
                            <td class="text-nowrap @(item.IsOverdue ? "overdue" : "")">@TicketDisplay.Date(item.DueAt)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
