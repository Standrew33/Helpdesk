@page "{id:int}"
@model Helpdesk.Web.Pages.Tickets.EditModel
@{
    ViewData["Title"] = $"Edit ticket #{Model.Id}";
}

<a class="back-link" asp-page="Details" asp-route-id="@Model.Id">&larr; Ticket #@Model.Id</a>

<div class="page-header">
    <div>
        <h1 class="page-title">Edit ticket</h1>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body p-4">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-2"></div>
                    <input type="hidden" name="rowVersion" value="@Model.RowVersion" />

                    <div class="mb-3">
                        <label asp-for="Input.Subject" class="form-label"></label>
                        <input asp-for="Input.Subject" class="form-control" />
                        <span asp-validation-for="Input.Subject" class="field-validation-error"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Description" class="form-label"></label>
                        <textarea asp-for="Input.Description" class="form-control" rows="7"></textarea>
                        <span asp-validation-for="Input.Description" class="field-validation-error"></span>
                    </div>
                    <div class="mb-4">
                        <label id="PriorityLabel" for="Priority" class="form-label">Priority</label>
                        <partial name="_PriorityChoice" model="Model.PriorityChoice" />
                    </div>
                    <button type="submit" class="btn btn-primary">Save</button>
                    <a class="btn btn-link" asp-page="Details" asp-route-id="@Model.Id">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
