@page
@model Helpdesk.Web.Pages.InvitationsModel
@using Helpdesk.Web.Features.Tickets
@{
    ViewData["Title"] = "Invitations";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Invitations</h1>
        <p class="page-subtitle">Bring people into your help desk. They get an e-mail with a link that is valid for @((int)Helpdesk.Web.Data.Invitation.Lifetime.TotalDays) days.</p>
    </div>
</div>


<div class="card mb-4">
    <div class="card-body p-4">
        <h2 class="h5 mb-3">Invite someone</h2>
        <form method="post" class="invite-form">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-2"></div>
            <div class="invite-fields">
                <div class="invite-email">
                    <label asp-for="Input.Email" class="form-label"></label>
                    <input asp-for="Input.Email" class="form-control" type="email" autocomplete="off" />
                    <span asp-validation-for="Input.Email" class="field-validation-error field-message"></span>
                </div>
                @if (Model.Roles.Count > 1)
                {
                    <div class="invite-role">
                        <label asp-for="Input.Role" class="form-label"></label>
                        <select asp-for="Input.Role" class="form-select">
                            @foreach (var role in Model.Roles)
                            {
                                <option value="@role">@role</option>
                            }
                        </select>
                    </div>
                }
                else
                {
                    <input type="hidden" asp-for="Input.Role" value="@Model.Roles[0]" />
                }
                <div class="invite-send">
                    <button type="submit" class="btn btn-primary">Send invitation</button>
                </div>
            </div>
            @if (Model.Roles.Count == 1)
            {
                <p class="form-text mb-0 mt-2">Operators invite customers. Ask an administrator to invite staff.</p>
            }
        </form>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body p-4">
        <h2 class="h5 mb-1">Link for customers</h2>
        <p class="text-secondary mb-3">@(Model.JoinLink.IsOpen ? "Customers who open it sign up by themselves." : "The link is off: customers join by invitation only.")</p>
        <div class="join-link-field">
            @if (Model.CanChangeJoinLink)
            {
                <div class="join-link-actions">
                    <form method="post" asp-page-handler="JoinLink">
                        <input type="hidden" name="open" value="@((!Model.JoinLink.IsOpen).ToString().ToLowerInvariant())" />
                        @if (Model.JoinLink.IsOpen)
                        {
                            <button type="submit" class="icon-btn" title="Turn the link off" aria-label="Turn the link off">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 17H7a5 5 0 0 1 0-10h2M15 7h2a5 5 0 0 1 4 8M8 12h4M3 3l18 18" /></svg>
                            </button>
                        }
                        else
                        {
                            <button type="submit" class="icon-btn" title="Turn the link on" aria-label="Turn the link on">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 17H7a5 5 0 0 1 0-10h2M15 7h2a5 5 0 0 1 0 10h-2M8 12h8" /></svg>
                            </button>
                        }
                    </form>
                    @if (Model.JoinLink.IsOpen)
                    {
                        <form method="post" asp-page-handler="NewJoinLink">
                            <button type="submit" class="icon-btn" title="Make a new link; the old one stops working" aria-label="Make a new link; the old one stops working">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-2.64-6.36L21 8" /><path d="M21 3v5h-5" /></svg>
                            </button>
                        </form>
                    }
                </div>
            }
            <label for="join-link" class="visually-hidden">Link for customers</label>
            @if (Model.JoinLink.IsOpen)
            {
                <input id="join-link" class="form-control join-link" value="@Model.JoinLink.Url" readonly />
            }
            else
            {
                <input id="join-link" class="form-control join-link" placeholder="Turned off" readonly disabled />
            }
        </div>
    </div>
</div>

<h2 class="h5 mb-3">Waiting for an answer</h2>

@if (Model.Waiting.Count == 0)
{
    <div class="card"><div class="empty-state"><h2>No open invitations</h2><p>Everyone invited has joined, or nobody has been invited yet.</p></div></div>
}
else
{
    <div class="card overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle ticket-table">
                <thead>
                    <tr>
                        <th>E-mail</th>
                        <th>Role</th>
                        <th>Invited by</th>
                        <th>Valid until</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var invitation in Model.Waiting)
                    {
                        <tr>
                            <td class="fw-semibold">@invitation.Email</td>
                            <td>@invitation.Role</td>
                            <td>@invitation.InvitedBy</td>
                            <td class="text-nowrap">@TicketDisplay.Date(invitation.ExpiresAt)</td>
                            <td class="text-end">
                                @if (invitation.CanWithdraw)
                                {
                                    <div class="row-actions">
                                        <form method="post" asp-page-handler="Resend">
                                            <input type="hidden" name="id" value="@invitation.Id" />
                                            <button type="submit" class="btn btn-outline-secondary btn-sm">Resend</button>
                                        </form>
                                        <form method="post" asp-page-handler="Withdraw">
                                            <input type="hidden" name="id" value="@invitation.Id" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm">Revoke</button>
                                        </form>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
