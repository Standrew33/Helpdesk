@page
@model NewPasswordModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Choose a new password";
}

<h1 class="h3 fw-bold mb-1">Choose a new password</h1>
<p class="text-secondary mb-4">
    For <strong class="text-body">@Model.Email</strong>. Other devices signed in to this account will be signed out.
</p>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-2"></div>
    <input type="hidden" id="AccountEmail" value="@Model.Email" autocomplete="username" />
    <input type="hidden" id="AccountName" value="@Model.DisplayName" />

    <div class="mb-3">
        <label asp-for="Input.Password" class="form-label"></label>
        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" autofocus
               data-strength data-strength-related="#AccountEmail, #AccountName" />
        <span asp-validation-for="Input.Password" class="field-validation-error"></span>
    </div>
    <div class="mb-4">
        <label asp-for="Input.ConfirmPassword" class="form-label"></label>
        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Input.ConfirmPassword" class="field-validation-error"></span>
    </div>
    <button type="submit" class="btn btn-primary w-100">Save and sign in</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/password-strength.js" asp-append-version="true"></script>
}
