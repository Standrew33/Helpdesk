@page
@model LoginModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sign in";
}

@if (Model.JoiningName is not null)
{
    <h1 class="h3 fw-bold mb-1">Contact @Model.JoiningName</h1>
    <p class="text-secondary mb-4">Enter your e-mail address and we will send you a code. A new account becomes a customer of this help desk.</p>
}
else
{
    <h1 class="h3 fw-bold mb-1">Sign in or start your help desk</h1>
    <p class="text-secondary mb-4">Enter your e-mail address and we will send you a code. No password needed; a new address gets a help desk of its own.</p>
}

@if (Model.Notice is not null)
{
    <div class="alert alert-info" role="status">@Model.Notice</div>
}

<form method="post" asp-route-returnUrl="@Model.ReturnUrl">
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-2"></div>

    <div class="hp" aria-hidden="true">
        <label asp-for="Input.Website">Leave this field empty</label>
        <input asp-for="Input.Website" tabindex="-1" autocomplete="off" />
    </div>

    <div class="mb-4">
        <label asp-for="Input.Email" class="form-label"></label>
        <input asp-for="Input.Email" class="form-control" autocomplete="email" autofocus />
        <span asp-validation-for="Input.Email" class="field-validation-error"></span>
    </div>
    <button type="submit" class="btn btn-primary w-100">Continue with e-mail</button>
    <partial name="_Captcha" model="@("login")" />
</form>

<p class="text-secondary mt-4 mb-0">
    Have a password? <a asp-page="Password" asp-route-returnUrl="@Model.ReturnUrl">Sign in with a password</a>
</p>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
