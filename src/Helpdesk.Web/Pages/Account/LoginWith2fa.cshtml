@page
@model LoginWith2faModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Second step";
}

<h1 class="h3 fw-bold mb-1">Second step</h1>
<p class="text-secondary mb-4">Enter the six-digit code shown by your authenticator app.</p>

<form method="post" asp-route-returnUrl="@Model.ReturnUrl" asp-route-rememberMe="@Model.RememberMe">
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-2"></div>

    <div class="mb-4">
        <label asp-for="Input.Code" class="form-label"></label>
        <input asp-for="Input.Code" class="form-control" inputmode="numeric" autocomplete="one-time-code" autofocus />
        <span asp-validation-for="Input.Code" class="field-validation-error"></span>
    </div>
    <button type="submit" class="btn btn-primary w-100">Verify</button>
</form>

<p class="text-secondary mt-4 mb-0">
    No access to the app? <a asp-page="LoginWithRecoveryCode" asp-route-returnUrl="@Model.ReturnUrl">Use a recovery code</a>
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
