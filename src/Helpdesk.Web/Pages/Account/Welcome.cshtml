@page
@model WelcomeModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Create your account";
}

@if (Model.GoneMessage is not null)
{
    <h1 class="h3 fw-bold mb-3">@Model.GoneTitle</h1>
    <p class="text-secondary mb-4">@Model.GoneMessage</p>
    <a asp-page="Login" class="btn btn-outline-secondary w-100">Go to sign-in</a>
    return;
}

<h1 class="h3 fw-bold mb-1">@(Model.JoinName is not null ? $"Join {Model.JoinName}" : Model.IsOwner ? "Welcome, superadmin" : "Welcome to Helpdesk")</h1>
<p class="text-secondary mb-4">
    <strong class="text-body">@Model.Email</strong> is confirmed.
    @if (Model.JoinRole is not null)
    {
        <span>You join as @(Model.JoinRole == "Customer" ? "a" : "an") @Model.JoinRole.ToLowerInvariant().</span>
    }
    @if (Model.IsOwner)
    {
        <span>This address owns the platform: your account looks after every help desk and belongs to none of them.</span>
    }
</p>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-2"></div>
    <input type="hidden" asp-for="Email" autocomplete="username" />

    <div class="mb-3">
        <label asp-for="Input.DisplayName" class="form-label"></label>
        <input asp-for="Input.DisplayName" class="form-control" autocomplete="name" autofocus />
        <span asp-validation-for="Input.DisplayName" class="field-validation-error"></span>
    </div>
    @if (Model.JoinName is null && !Model.IsOwner)
    {
        <div class="mb-3">
            <label asp-for="Input.WorkspaceName" class="form-label"></label>
            <input asp-for="Input.WorkspaceName" class="form-control" autocomplete="organization" aria-describedby="workspace-help" />
            <div id="workspace-help" class="form-text">You get a help desk of your own and run it as its administrator. Without a name it is called after you.</div>
            <span asp-validation-for="Input.WorkspaceName" class="field-validation-error"></span>
        </div>
    }
    <div class="mb-3">
        <label asp-for="Input.Password" class="form-label"></label>
        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" data-strength data-strength-related="#Email, #Input_DisplayName" />
        <span asp-validation-for="Input.Password" class="field-validation-error"></span>
    </div>
    <div class="mb-4">
        <label asp-for="Input.ConfirmPassword" class="form-label"></label>
        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Input.ConfirmPassword" class="field-validation-error"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100">Create account</button>
    <button type="submit" name="skip" value="true" formnovalidate class="btn btn-link w-100 mt-2">Skip</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/password-strength.js" asp-append-version="true"></script>
}
