@page
@model ForgotPasswordModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot your password";
}

<h1 class="h3 fw-bold mb-1">Forgot your password?</h1>
<p class="text-secondary mb-4">Enter your e-mail address. We will send a code to choose a new password.</p>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-2"></div>

    <div class="hp" aria-hidden="true">
        <label asp-for="Input.Website">Leave this field empty</label>
        <input asp-for="Input.Website" tabindex="-1" autocomplete="off" />
    </div>

    <div class="mb-4">
        <label asp-for="Input.Email" class="form-label"></label>
        <input asp-for="Input.Email" class="form-control" autocomplete="email" autofocus />
        <span asp-validation-for="Input.Email" class="field-validation-error"></span>
    </div>
    <button type="submit" class="btn btn-primary w-100">Send a code</button>
</form>

<div class="step-links">
    <a asp-page="Password">Back to sign-in with a password</a>
    <a asp-page="Login">Sign in with a code instead</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
