@page
@model PasswordModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sign in with a password";
}

<h1 class="h3 fw-bold mb-1">Sign in with a password</h1>
<p class="text-secondary mb-4">For accounts that have a password. Every account can also sign in with a code from e-mail.</p>

<form method="post" asp-route-returnUrl="@Model.ReturnUrl">
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-2"></div>

    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label"></label>
        <input asp-for="Input.Email" class="form-control" autocomplete="username" autofocus />
        <span asp-validation-for="Input.Email" class="field-validation-error"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Password" class="form-label"></label>
        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
        <span asp-validation-for="Input.Password" class="field-validation-error"></span>
    </div>
    <div class="form-check mb-4">
        <input asp-for="Input.RememberMe" class="form-check-input" />
        <label asp-for="Input.RememberMe" class="form-check-label"></label>
    </div>
    <button type="submit" class="btn btn-primary w-100">Sign in</button>
    <partial name="_Captcha" model="@("password")" />
</form>

<div class="step-links">
    <a asp-page="ForgotPassword">Forgot your password?</a>
    <a asp-page="Login" asp-route-returnUrl="@Model.ReturnUrl">Sign in with a code from e-mail instead</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
