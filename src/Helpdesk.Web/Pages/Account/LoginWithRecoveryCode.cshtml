@page
@model LoginWithRecoveryCodeModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Recovery code";
}

<h1 class="h3 fw-bold mb-1">Use a recovery code</h1>
<p class="text-secondary mb-4">Enter one of the recovery codes you saved when you turned on two-factor authentication. Each code works once.</p>

<form method="post" asp-route-returnUrl="@Model.ReturnUrl">
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-2"></div>

    <div class="mb-4">
        <label asp-for="Input.RecoveryCode" class="form-label"></label>
        <input asp-for="Input.RecoveryCode" class="form-control" autocomplete="off" autofocus />
        <span asp-validation-for="Input.RecoveryCode" class="field-validation-error"></span>
    </div>
    <button type="submit" class="btn btn-primary w-100">Sign in</button>
</form>

<p class="text-secondary mt-4 mb-0">
    <a asp-page="Login">Back to sign-in</a>
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
