@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="py-4">
    <h1 class="display-6">Helpdesk</h1>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <p class="text-muted">Signed in as @User.Identity.Name.</p>
    }
    else
    {
        <p class="text-muted">A small ticketing system. Please sign in to continue.</p>
        <a class="btn btn-primary" asp-page="/Account/Login">Sign in</a>
    }
</div>
