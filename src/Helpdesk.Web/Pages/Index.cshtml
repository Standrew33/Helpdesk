@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<section class="hero">
    <h1>Support tickets,<br />handled on time.</h1>
    <p>
        Customers open tickets, operators resolve them within a deadline that depends on priority,
        and every change is recorded.
    </p>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a class="btn btn-primary btn-lg" asp-page="/Tickets/Index">Go to tickets</a>
    }
    else
    {
        <a class="btn btn-primary btn-lg" asp-page="/Account/Login">Sign in</a>
    }
</section>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card h-100"><div class="card-body">
            <span class="feature-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v5c0 5-3.5 8-7 10-3.5-2-7-5-7-10V6z" /></svg>
            </span>
            <h2 class="h6 fw-bold">Roles and access</h2>
            <p class="text-secondary mb-0">Customers see only their own tickets. Operators and administrators work the whole queue.</p>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card h-100"><div class="card-body">
            <span class="feature-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
            </span>
            <h2 class="h6 fw-bold">Deadlines by priority</h2>
            <p class="text-secondary mb-0">Every priority has a resolution deadline, and overdue tickets stand out in the list.</p>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card h-100"><div class="card-body">
            <span class="feature-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 7h14M5 12h14M5 17h9" /></svg>
            </span>
            <h2 class="h6 fw-bold">Full history</h2>
            <p class="text-secondary mb-0">Status, priority and assignee changes are recorded and visible to the support team.</p>
        </div></div>
    </div>
</div>
