@page
@model ErrorModel
@{
    ViewData["Title"] = Model.Heading;
}

<div class="card auth-wrap">
    <div class="empty-state">
        <h1 class="h4">@Model.Heading</h1>
        <p>@Model.Message</p>
        @if (Model.Code >= 500 && Model.ShowRequestId)
        {
            <p class="small">Request ID: <code>@Model.RequestId</code></p>
        }
        <a class="btn btn-primary" asp-page="/Index">Back to the start page</a>
    </div>
</div>
