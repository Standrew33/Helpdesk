@page "{id:int}"
@model Helpdesk.Web.Pages.Platform.WorkspaceModel
@using Helpdesk.Web.Features.Tickets
@{
    var overview = Model.Overview;
    ViewData["Title"] = overview.Name;
    ViewData["PageClass"] = "page-wide";
}

<a asp-page="Index" class="back-link">&larr; All workspaces</a>

<div class="page-header">
    <div>
        <h1 class="page-title">@overview.Name</h1>
        <p class="page-subtitle">
            Since @TicketDisplay.Date(overview.CreatedAt) &middot;
            <span class="pill @(overview.IsBlocked ? "pill-closed" : "pill-active")">@(overview.IsBlocked ? "Deactivated" : "Active")</span>
        </p>
    </div>
    <form method="post" asp-page-handler="Block" asp-route-id="@overview.Id">
        <input type="hidden" name="blocked" value="@((!overview.IsBlocked).ToString().ToLowerInvariant())" />
        <button type="submit" class="btn btn-outline-secondary">@(overview.IsBlocked ? "Activate the workspace" : "Deactivate the workspace")</button>
    </form>
</div>

@if (Model.Error is not null)
{
    <div class="alert alert-danger" role="alert">@Model.Error</div>
}
@if (Model.Notice is not null)
{
    <div class="alert alert-success" role="status">@Model.Notice</div>
}

<h2 class="h5 mb-3">People</h2>
<div class="card overflow-hidden mb-4">
    <div class="table-responsive">
        <table class="table align-middle ticket-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var person in overview.People)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@person.DisplayName</div>
                            <div class="text-secondary small">@person.Email</div>
                        </td>
                        <td>@person.Role</td>
                        <td><span class="pill @(person.IsActive ? "pill-active" : "pill-closed")">@(person.IsActive ? "Active" : "Deactivated")</span></td>
                        <td class="text-end">
                            @if (!person.IsOwner)
                            {
                                <div class="row-actions">
                                    <form method="post" asp-page-handler="Active" asp-route-id="@overview.Id">
                                        <input type="hidden" name="userId" value="@person.Id" />
                                        <input type="hidden" name="active" value="@((!person.IsActive).ToString().ToLowerInvariant())" />
                                        <button type="submit" class="btn btn-outline-secondary btn-sm">@(person.IsActive ? "Deactivate" : "Activate")</button>
                                    </form>
                                    <partial name="_DeleteAccount" model="@(new Helpdesk.Web.Features.Users.DeleteAccountButton(person.Id, person.DisplayName))" />
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<h2 class="h5 mb-3">Tickets</h2>
@if (overview.Tickets.Count == 0)
{
    <div class="card"><div class="empty-state"><h2>No tickets yet</h2><p>Nobody has opened a ticket in this workspace.</p></div></div>
}
else
{
    <div class="card overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle ticket-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Subject</th>
                        <th>Status</th>
                        <th>Priority</th>
                        <th>Customer</th>
                        <th>Updated</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ticket in overview.Tickets)
                    {
                        <tr>
                            <td class="ticket-id">@ticket.Number</td>
                            <td><a class="ticket-subject" asp-page="Ticket" asp-route-workspaceId="@overview.Id" asp-route-number="@ticket.Number">@ticket.Subject</a></td>
                            <td><span class="pill @TicketDisplay.StatusClass(ticket.Status)">@TicketDisplay.StatusText(ticket.Status)</span></td>
                            <td><partial name="_Priority" model="ticket.Priority" /></td>
                            <td>@ticket.CustomerName</td>
                            <td class="text-nowrap">@TicketDisplay.Date(ticket.UpdatedAt)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (overview.Tickets.Count >= Model.MaxTicketsShown)
    {
        <p class="text-secondary small mt-2">Showing the @Model.MaxTicketsShown tickets changed most recently.</p>
    }
}

<div class="card danger-card mt-5">
    <div class="card-body p-4">
        <h2 class="h5 mb-1">Delete the workspace</h2>
        <p class="text-secondary mb-3">Deletes its people, tickets, comments, files and invitations for good. This cannot be undone.</p>
        <form method="post" asp-page-handler="DeleteWorkspace" asp-route-id="@overview.Id" class="delete-workspace">
            <label for="confirmName" class="form-label">Type <strong>@overview.Name</strong> to confirm</label>
            <div class="delete-workspace-fields">
                <input id="confirmName" name="confirmName" class="form-control" autocomplete="off" required />
                <button type="submit" class="btn btn-danger">Delete the workspace</button>
            </div>
        </form>
    </div>
</div>

<partial name="_DeleteAccountDialog" model="@(new Helpdesk.Web.Features.Users.DeleteAccountDialog("userId", new Dictionary<string, string?> { ["id"] = overview.Id.ToString(System.Globalization.CultureInfo.InvariantCulture) }))" />

@section Scripts {
    <script src="~/js/delete-account.js" asp-append-version="true"></script>
}
