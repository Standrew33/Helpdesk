@page "{workspaceId:int}/{number:int}"
@model Helpdesk.Web.Pages.Platform.TicketModel
@using Helpdesk.Web.Features.Tickets
@{
    var details = Model.Details;
    var ticket = details.Ticket;
    ViewData["Title"] = $"{Model.WorkspaceName} #{ticket.Number}";
}

<a class="back-link" asp-page="Workspace" asp-route-id="@Model.WorkspaceId">&larr; @Model.WorkspaceName</a>

<div class="page-header">
    <div>
        <p class="page-subtitle m-0">@Model.WorkspaceName &middot; Ticket #@ticket.Number &middot; read only</p>
        <h1 class="page-title">@ticket.Subject</h1>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-body">
                <p class="text-secondary small mb-2">Opened by @details.NameOf(ticket.CustomerId) on @TicketDisplay.Date(ticket.CreatedAt)</p>
                <p class="description mb-0">@ticket.Description</p>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <h2 class="card-title-sm">Attachments</h2>
                @if (ticket.Attachments.Count == 0)
                {
                    <p class="text-secondary mb-0">No files attached.</p>
                }
                else
                {
                    <ul class="file-list">
                        @foreach (var file in ticket.Attachments.OrderBy(a => a.UploadedAt))
                        {
                            <li>
                                <span>@file.FileName</span>
                                <span class="text-secondary small">@TicketDisplay.FileSize(file.Size) &middot; @details.NameOf(file.UploadedById) &middot; @TicketDisplay.Date(file.UploadedAt)</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>

        <h2 class="section-title">History</h2>
        <div class="card mb-4">
            <div class="card-body">
                <ul class="timeline">
                    @foreach (var entry in ticket.History.OrderBy(h => h.ChangedAt).ThenBy(h => h.Id))
                    {
                        <li>
                            @if (entry.Field == "Created")
                            {
                                <text>Ticket created</text>
                            }
                            else if (entry.Field == "Attachment")
                            {
                                <text>Attached @entry.NewValue</text>
                            }
                            else if (entry.Field == "Description")
                            {
                                <text>Description edited</text>
                            }
                            else if (entry.Field == "Assignee")
                            {
                                <text>Assignee: @details.NameOf(entry.OldValue) &rarr; @details.NameOf(entry.NewValue)</text>
                            }
                            else
                            {
                                <text>@entry.Field: @entry.OldValue &rarr; @entry.NewValue</text>
                            }
                            <small>@details.NameOf(entry.ActorId) &middot; @TicketDisplay.Date(entry.ChangedAt)</small>
                        </li>
                    }
                </ul>
            </div>
        </div>

        <h2 class="section-title">Comments</h2>
        @if (details.Comments.Count == 0)
        {
            <p class="text-secondary">No comments yet.</p>
        }
        <div class="comment-list">
            @foreach (var comment in details.Comments)
            {
                var author = details.NameOf(comment.AuthorId);
                <div class="comment @(comment.IsInternal ? "comment-internal" : "")">
                    <span class="avatar" aria-hidden="true">@(author.Length > 0 ? author[..1] : "?")</span>
                    <div class="comment-body">
                        <div class="comment-head">
                            <strong>@author</strong>
                            <span>@TicketDisplay.Date(comment.CreatedAt)</span>
                            @if (comment.IsInternal)
                            {
                                <span class="tag tag-internal">Internal note</span>
                            }
                        </div>
                        <div class="comment-text">@comment.Body</div>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <h2 class="card-title-sm">Details</h2>
                <dl class="meta-list">
                    <dt>Status</dt>
                    <dd><span class="pill @TicketDisplay.StatusClass(ticket.Status)">@TicketDisplay.StatusText(ticket.Status)</span></dd>
                    <dt>Priority</dt>
                    <dd><partial name="_Priority" model="ticket.Priority" /></dd>
                    <dt>Assignee</dt>
                    <dd>@details.NameOf(ticket.AssigneeId)</dd>
                    <dt>Due</dt>
                    <dd>@TicketDisplay.Day(ticket.DueDate, Ticket.Today(DateTimeOffset.UtcNow))</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
