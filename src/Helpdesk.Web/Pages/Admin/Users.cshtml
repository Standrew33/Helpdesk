@page
@model Helpdesk.Web.Pages.Admin.UsersModel
@{
    ViewData["Title"] = "Users";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Users</h1>
        <p class="page-subtitle">Roles and access. Role changes apply the next time the person opens a page.</p>
    </div>
</div>

@if (Model.Error is not null)
{
    <div class="alert alert-danger" role="alert">@Model.Error</div>
}
@if (Model.Notice is not null)
{
    <div class="alert alert-success" role="status">@Model.Notice</div>
}

<form method="get" class="toolbar">
    <input type="search" name="q" value="@Model.Search" class="form-control toolbar-search" placeholder="Search by name or e-mail" aria-label="Search users" />
    <button type="submit" class="btn btn-outline-secondary">Search</button>
    @if (!string.IsNullOrEmpty(Model.Search))
    {
        <a class="btn btn-link" asp-page="Users">Reset</a>
    }
</form>

@if (Model.Users.Count == 0)
{
    <div class="card"><div class="empty-state"><h2>No users found</h2><p>Nobody matches this search.</p></div></div>
}
else
{
    <div class="card overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle ticket-table user-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@user.DisplayName @if (user.IsSelf) { <span class="text-secondary fw-normal">(you)</span> }</div>
                                <div class="text-secondary small">@user.Email</div>
                            </td>
                            <td>
                                @if (user.IsSelf || user.IsProtected)
                                {
                                    <span>@user.Role</span>
                                    <div class="text-secondary small">@(user.IsProtected ? "Demo account" : "Your own role")</div>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="Role" class="inline-form" asp-route-q="@Model.Search">
                                        <input type="hidden" name="id" value="@user.Id" />
                                        <select name="role" class="form-select form-select-sm" aria-label="Role of @user.DisplayName">
                                            @foreach (var role in Model.Roles)
                                            {
                                                <option value="@role" selected="@(role == user.Role)">@role</option>
                                            }
                                        </select>
                                        <button type="submit" class="btn btn-outline-primary btn-sm">Save</button>
                                    </form>
                                }
                            </td>
                            <td>
                                <span class="pill @(user.IsActive ? "pill-active" : "pill-closed")">@(user.IsActive ? "Active" : "Deactivated")</span>
                            </td>
                            <td class="text-end">
                                @if (!user.IsSelf && !user.IsProtected)
                                {
                                    <form method="post" asp-page-handler="Active" asp-route-q="@Model.Search">
                                        <input type="hidden" name="id" value="@user.Id" />
                                        <input type="hidden" name="active" value="@((!user.IsActive).ToString().ToLowerInvariant())" />
                                        <button type="submit" class="btn btn-outline-secondary btn-sm">@(user.IsActive ? "Deactivate" : "Activate")</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.Users.Count >= Model.MaxListSize)
    {
        <p class="text-secondary small mt-2">Showing the first @Model.MaxListSize users. Use the search to narrow the list.</p>
    }
}
